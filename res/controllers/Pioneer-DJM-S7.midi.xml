<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.6">
    <info>
        <name>Pioneer DJ DJM-S7</name>
        <author>Thomas Wunner</author>
        <description>Mapping for the Pioneer DJ DJM-S7 battle mixer. Covers the internal mixer (14-bit faders/EQ/filter), browse/load, loop and the performance pads with software-tracked pad modes (Hot Cue / Roll / Saved Loop / Sampler). Transport is expected to come from timecode turntables via Mixxx vinyl control.</description>
    </info>
    <controller id="DJM-S7">
        <scriptfiles>
            <file functionprefix="PioneerDJMS7" filename="Pioneer-DJM-S7-script.js"/>
        </scriptfiles>
        <controls>
            <!-- ============================ MIXER ============================ -->

            <!-- CHANNEL FADER -->
            <control>
                <description>CH1 CHANNEL FADER (MSB)</description>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x13</midino>
                <options><fourteen-bit-msb/></options>
            </control>
            <control>
                <description>CH1 CHANNEL FADER (LSB)</description>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x33</midino>
                <options><fourteen-bit-lsb/></options>
            </control>
            <control>
                <description>CH2 CHANNEL FADER (MSB)</description>
                <group>[Channel2]</group>
