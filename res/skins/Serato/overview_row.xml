<Template>
  <!--
    One Serato overview strip, kept flush with the waveform below it.

    The waveform row is [Visual | BeatgridControls], so when the beatgrid panel
    is shown the Visual is narrower than a full-width overview and the overview
    would run over the panel. We reserve the panel's exact width on the right of
    the overview, gated by the same config keys as the panel itself, so the
    overview ends exactly at the Visual's edge - and goes full width again when
    the panel is hidden.

    Variables:
      StyleName    - ObjectName for QSS (SeratoOverview1 / SeratoOverview2)
      OverviewName - Singleton ObjectName (DeckOverview1..4)
  -->
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,f</SizePolicy>
    <Size>0me,24f</Size>
    <Children>
      <WidgetGroup>
        <ObjectName><Variable name="StyleName"/></ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <SingletonContainer>
            <ObjectName><Variable name="OverviewName"/></ObjectName>
          </SingletonContainer>
        </Children>
      </WidgetGroup>

      <!-- Reserve the BeatgridControls width: 107f = 1f gap + 4*26f button
           columns + 2px border; the extra 26f hotcue-shift column only when
           timing_shift_buttons is on. Whole block hidden (overview full width)
           unless show_beatgrid_controls is on - matching the panel. -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>max,f</SizePolicy>
        <Children>
          <WidgetGroup><Size>107f,1min</Size></WidgetGroup>
          <WidgetGroup>
            <Size>26f,1min</Size>
            <Connection>
              <ConfigKey persist="true">[Skin],timing_shift_buttons</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_beatgrid_controls</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
