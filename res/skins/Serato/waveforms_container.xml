<Template>

  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>WaveformsContainer</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <RequiresStem>true</RequiresStem>
            <Layout>vertical</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/controls/button_2state_persist.xml">
                <SetVariable name="TooltipId">show_stem_controls</SetVariable>
                <SetVariable name="ObjectName">StemControlsToggle</SetVariable>
                <SetVariable name="Size">26f,52f</SetVariable>
                <SetVariable name="BtnSize"></SetVariable>
                <SetVariable name="ConfigKey">[Skin],show_stem_controls</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>100me,40me</Size>
            <Children>

              <!-- All four waveforms are equal-height "me" siblings so they
                   share the vertical space evenly. Each deck draws its own
                   beat-match marker bar at its inner edge; deck 1+2 and deck
                   3+4 are placed back-to-back so those bars meet to form one
                   central lane per pair (Serato style). -->

              <!-- Deck 1: overview on top, waveform below -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>SeratoOverview1</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,24f</Size>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>DeckOverview1</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skins:LateNight/waveform.xml">
                        <SetVariable name="ChanNum">1</SetVariable>
                        <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                        <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
                        <SetVariable name="BeatMatchEdge">bottom</SetVariable>
                        <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- Deck 2: waveform on top, overview below -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skins:LateNight/waveform.xml">
                        <SetVariable name="ChanNum">2</SetVariable>
                        <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                        <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
                        <SetVariable name="BeatMatchEdge">top</SetVariable>
                        <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>SeratoOverview2</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,24f</Size>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>DeckOverview2</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- Deck 3 (4-deck only): overview on top, waveform below -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>SeratoOverview1</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,24f</Size>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>DeckOverview3</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skins:LateNight/waveform.xml">
                        <SetVariable name="ChanNum">3</SetVariable>
                        <SetVariable name="SignalColor"><Variable name="SignalColor_34"/></SetVariable>
                        <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_34"/></SetVariable>
                        <SetVariable name="BeatMatchEdge">bottom</SetVariable>
                        <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                </Children>
                <Connection>
                  <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>

              <!-- Deck 4 (4-deck only): waveform on top, overview below -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skins:LateNight/waveform.xml">
                        <SetVariable name="ChanNum">4</SetVariable>
                        <SetVariable name="SignalColor"><Variable name="SignalColor_34"/></SetVariable>
                        <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_34"/></SetVariable>
                        <SetVariable name="BeatMatchEdge">top</SetVariable>
                        <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>SeratoOverview2</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,24f</Size>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>DeckOverview4</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                </Children>
                <Connection>
                  <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1f,1min</Size></WidgetGroup>

          <Template src="skins:LateNight/controls/button_2state_persist.xml">
            <SetVariable name="TooltipId">show_beatgrid_controls</SetVariable>
            <SetVariable name="ObjectName">BeatgridControlsToggle</SetVariable>
            <SetVariable name="Size">26f,52f</SetVariable>
            <SetVariable name="BtnSize"></SetVariable>
            <SetVariable name="ConfigKey">[Skin],show_beatgrid_controls</SetVariable>
          </Template>

          <WidgetGroup>
            <Size>2f,1min</Size>
            <Connection>
              <ConfigKey>[Master],skin_settings</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey>[Master],skin_settings</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup><!-- WaveformsContainer -->

    </Children>
  </WidgetGroup>
</Template>
