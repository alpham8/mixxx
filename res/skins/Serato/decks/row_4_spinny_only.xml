<Template>
  <SetVariable name="BtnType"></SetVariable>

  <WidgetGroup>
    <ObjectName>DeckRow_4_OverviewSpinny</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <!-- Spinny only, no overview -->
      <WidgetGroup>
        <ObjectName>SpinnyCoverContainer_SmallCompact</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>f,f</SizePolicy>
        <Children>
          <SingletonContainer>
            <ObjectName>SpinnyCoverart<Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
        </Children>
        <Connection>
          <ConfigKey>[Skin],show_small_spinny_or_cover</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
