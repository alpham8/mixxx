<!--
  Serato-style beatloop pad grid with two pageable size ranges (RIGHT decks 2/4).
  Mirror of deck_serato_loops.xml but with page_r* page controls so the right
  decks page independently from the left. Variables: Group

  Each pad shows a blue selection outline while its size equals beatloop_size,
  see button_beatloop_size.xml.
-->
<Template>
  <WidgetGroup>
    <ObjectName>SeratoBeatLoops</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <PushButton>
        <ObjectName>LoopPageBtn</ObjectName>
        <TooltipId>beatloop_size</TooltipId>
        <Size>20f,52f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>&#x00AB;</Text></State>
        <Connection>
          <ConfigKey>[SeratoLoop],page_r_small</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>

      <WidgetStack currentpage="[SeratoLoop],page_r" persist="true">
        <Children>

          <!-- Page 0 (default): 1/8 .. 16 -->
          <WidgetGroup trigger="[SeratoLoop],page_r_small">
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout><SizePolicy>me,min</SizePolicy>
                <Children>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">1/8</SetVariable><SetVariable name="LoopSize">0.125</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">1/4</SetVariable><SetVariable name="LoopSize">0.25</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">1/2</SetVariable><SetVariable name="LoopSize">0.5</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">1</SetVariable><SetVariable name="LoopSize">1</SetVariable></Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout><SizePolicy>me,min</SizePolicy>
                <Children>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">2</SetVariable><SetVariable name="LoopSize">2</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">4</SetVariable><SetVariable name="LoopSize">4</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">8</SetVariable><SetVariable name="LoopSize">8</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">16</SetVariable><SetVariable name="LoopSize">16</SetVariable></Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- Page 1 (large): 4 .. 512 -->
          <WidgetGroup trigger="[SeratoLoop],page_r_large">
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout><SizePolicy>me,min</SizePolicy>
                <Children>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">4</SetVariable><SetVariable name="LoopSize">4</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">8</SetVariable><SetVariable name="LoopSize">8</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">16</SetVariable><SetVariable name="LoopSize">16</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">32</SetVariable><SetVariable name="LoopSize">32</SetVariable></Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout><SizePolicy>me,min</SizePolicy>
                <Children>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">64</SetVariable><SetVariable name="LoopSize">64</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">128</SetVariable><SetVariable name="LoopSize">128</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">256</SetVariable><SetVariable name="LoopSize">256</SetVariable></Template>
                  <Template src="skins:Serato/decks/button_beatloop_size.xml"><SetVariable name="Group"><Variable name="Group"/></SetVariable><SetVariable name="Size">0me,26f</SetVariable><SetVariable name="LoopLabel">512</SetVariable><SetVariable name="LoopSize">512</SetVariable></Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetStack>

      <PushButton>
        <ObjectName>LoopPageBtn</ObjectName>
        <TooltipId>beatloop_size</TooltipId>
        <Size>20f,52f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>&#x00BB;</Text></State>
        <Connection>
          <ConfigKey>[SeratoLoop],page_r_large</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>

    </Children>
  </WidgetGroup>
</Template>
